{
  "profile": "mac",
  "cache_dir": "~/.cache/tv-launcher",
  "evdev": true,
  "cec": {
    "enabled": false,
    "name": "TV Launcher",
    "wake_tv": true,
    "binary": "cec-client",
    "log_level": 16
  },
  "profiles": {
    "mac": {
      "mpv": [
        "mpv",
        "--idle=yes",
        "--force-window=yes",
        "--no-terminal",
        "--no-config",
        "--osc=no",
        "--input-ipc-server={sock}",
        "--input-conf={inputconf}",
        "--no-input-default-bindings",
        "--title=${force-media-title}",
        "--geometry=720x540",
        "--auto-window-resize=no",
        "--keep-open=no",
        "--audio-display=no",
        "--user-agent=tv-launcher/0.1 (personal, non-commercial)",
        "--network-timeout=30",
        "--cache=yes",
        "--demuxer-max-bytes=64MiB",
        "--ytdl=no",
        "--sub-auto=no",
        "--sub-font-size=42",
        "--sub-border-size=2.5",
        "--sub-pos=94"
      ],
      "noise_graph": "av://lavfi:nullsrc=s=192x144:r=15,geq=random(1)*255:128:128",
      "black_graph": "av://lavfi:color=c=black:s=320x240:r=5"
    },
    "pi": {
      "_note": "Measured on a Pi 2: --vo=gpu --gpu-context=drm --profile=fast plays smoothly with hardware decode (v4l2m2m-copy); --vo=drm (CPU scaling) was too slow at HDMI resolutions. Not yet tested on composite or a Pi 1.",
      "mpv": [
        "mpv",
        "--idle=yes",
        "--force-window=yes",
        "--no-terminal",
        "--no-config",
        "--osc=no",
        "--input-ipc-server={sock}",
        "--input-conf={inputconf}",
        "--no-input-default-bindings",
        "--vo=gpu",
        "--gpu-context=drm",
        "--profile=fast",
        "--hwdec=v4l2m2m-copy",
        "--framedrop=vo",
        "--vd-lavc-threads=1",
        "--keep-open=no",
        "--audio-display=no",
        "--user-agent=tv-launcher/0.1 (personal, non-commercial)",
        "--network-timeout=30",
        "--cache=yes",
        "--demuxer-max-bytes=16MiB",
        "--demuxer-readahead-secs=20",
        "--ytdl=no",
        "--sub-auto=no",
        "--sub-font-size=42",
        "--sub-border-size=2.5",
        "--sub-pos=94",
        "--audio-device=alsa/plughw:CARD=Headphones,DEV=0"
      ],
      "noise_graph": "av://lavfi:nullsrc=s=96x72:r=12,geq=random(1)*255:128:128",
      "black_graph": "av://lavfi:color=c=black:s=160x120:r=5"
    },
    "hdmi": {
      "_note": "Measured on a Pi 2. --vo=gpu --gpu-context=drm --profile=fast plays smoothly with hardware decode (v4l2m2m-copy). 720p is deliberate: at 1080p the guide's overlay needs a texture bigger than the Pi GPU's 2048x2048 limit and stops drawing (mpv.log: 'OSD bitmaps do not fit on a surface'); --vo=drm (CPU scaling) was too slow.",
      "mpv": [
        "mpv",
        "--idle=yes",
        "--force-window=yes",
        "--no-terminal",
        "--no-config",
        "--osc=no",
        "--input-ipc-server={sock}",
        "--input-conf={inputconf}",
        "--no-input-default-bindings",
        "--vo=gpu",
        "--gpu-context=drm",
        "--profile=fast",
        "--drm-mode=1280x720",
        "--hwdec=v4l2m2m-copy",
        "--framedrop=vo",
        "--vd-lavc-threads=1",
        "--keep-open=no",
        "--audio-display=no",
        "--user-agent=tv-launcher/0.1 (personal, non-commercial)",
        "--network-timeout=30",
        "--cache=yes",
        "--demuxer-max-bytes=16MiB",
        "--demuxer-readahead-secs=20",
        "--ytdl=no",
        "--sub-auto=no",
        "--sub-font-size=42",
        "--sub-border-size=2.5",
        "--sub-pos=94",
        "--audio-device=alsa/hdmi:CARD=vc4hdmi,DEV=0"
      ],
      "noise_graph": "av://lavfi:nullsrc=s=160x90:r=12,geq=random(1)*255:128:128",
      "black_graph": "av://lavfi:color=c=black:s=160x90:r=5"
    },
    "desktop": {
      "_note": "Any Linux laptop or PC with a desktop (X11 or Wayland), e.g. a Pinebook or an old Atom netbook. Software decoding with automatic safe hardware decoding when the machine has it (VA-API). Starts fullscreen the first time (f toggles), then remembers the window. UNTESTED on real Linux hardware; for a weak CPU or old Intel graphics use desktop-lite.",
      "mpv": [
        "mpv",
        "--idle=yes",
        "--force-window=yes",
        "--no-terminal",
        "--no-config",
        "--osc=no",
        "--input-ipc-server={sock}",
        "--input-conf={inputconf}",
        "--no-input-default-bindings",
        "--title=${force-media-title}",
        "--keep-open=no",
        "--audio-display=no",
        "--user-agent=tv-launcher/0.1 (personal, non-commercial)",
        "--network-timeout=30",
        "--cache=yes",
        "--demuxer-max-bytes=64MiB",
        "--ytdl=no",
        "--sub-auto=no",
        "--sub-font-size=42",
        "--sub-border-size=2.5",
        "--sub-pos=94",
        "--autofit=60%",
        "--auto-window-resize=no",
        "--hwdec=auto-safe",
        "--vd-lavc-threads=0",
        "--framedrop=vo"
      ],
      "noise_graph": "av://lavfi:nullsrc=s=192x144:r=15,geq=random(1)*255:128:128",
      "black_graph": "av://lavfi:color=c=black:s=320x240:r=5",
      "remember_window": true,
      "fullscreen_first_run": true
    },
    "desktop-lite": {
      "_note": "For weak laptops (Atom N270 netbooks, 800 MHz CPUs): software decode with the cheaper settings (skips the loop filter on non-reference frames, fast decoding tricks) and the Xv video output, which uses the X server's own scaler instead of OpenGL (old Intel GPUs cannot run mpv's gpu output well). Needs X11. Console-only? replace --vo=xv with --vo=drm. UNTESTED.",
      "mpv": [
        "mpv",
        "--idle=yes",
        "--force-window=yes",
        "--no-terminal",
        "--no-config",
        "--osc=no",
        "--input-ipc-server={sock}",
        "--input-conf={inputconf}",
        "--no-input-default-bindings",
        "--title=${force-media-title}",
        "--keep-open=no",
        "--audio-display=no",
        "--user-agent=tv-launcher/0.1 (personal, non-commercial)",
        "--network-timeout=30",
        "--cache=yes",
        "--ytdl=no",
        "--sub-auto=no",
        "--sub-font-size=42",
        "--sub-border-size=2.5",
        "--sub-pos=94",
        "--autofit=60%",
        "--auto-window-resize=no",
        "--vd-lavc-threads=0",
        "--hwdec=no",
        "--vo=xv",
        "--vd-lavc-skiploopfilter=nonref",
        "--vd-lavc-fast",
        "--framedrop=decoder+vo",
        "--cache-secs=20",
        "--demuxer-max-bytes=24MiB"
      ],
      "noise_graph": "av://lavfi:nullsrc=s=192x144:r=15,geq=random(1)*255:128:128",
      "black_graph": "av://lavfi:color=c=black:s=320x240:r=5",
      "remember_window": true,
      "fullscreen_first_run": true
    }
  },
  "feeds": [
    {
      "name": "BBC News",
      "url": "https://feeds.bbci.co.uk/news/rss.xml"
    },
    {
      "name": "NOS",
      "url": "https://feeds.nos.nl/nosnieuwsalgemeen"
    }
  ],
  "photos": {
    "dirs": [
      "~/Pictures",
      "/media",
      "/mnt"
    ],
    "seconds": 8,
    "shuffle": true
  },
  "clock": {
    "seconds": false,
    "h24": true
  }
}