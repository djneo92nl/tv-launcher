[Unit]
Description=TV Launcher (home menu and apps)
After=network-online.target
Wants=network-online.target
Conflicts=spelunkr-tv.service
# a launcher that fails 5 times within 2 minutes is not coming back by itself: stop (see: journalctl -u tv-launcher), do not loop for ever
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=pi
Group=pi
SupplementaryGroups=video audio input render tty
WorkingDirectory=/opt/tv-launcher
ExecStart=/usr/bin/python3 /opt/tv-launcher/launcher.py --profile pi
# Run on the console so a USB keyboard controls it
StandardInput=tty-force
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=5
# the apps it starts are children: stopping the service must stop them too
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
